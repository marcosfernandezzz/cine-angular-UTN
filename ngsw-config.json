{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/*.css", "/*.js", "/manifest.webmanifest"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "supabase",
      "urls": ["https://*.supabase.co/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "10s",
        "maxSize": 100,
        "maxAge": "1h"
      }
    }
  ]
}